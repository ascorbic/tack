---
// "Or set it up with an agent": a button that copies a prompt for a coding
// agent in the reader's terminal, which points it at /setup.md (written by
// scripts/agents.ts). On the landing page's first screen and the deploy page.
//
// Copying swaps "Copy prompt" for "Copied" in place, over words that are
// always laid out, so nothing moves. Screen readers hear it from a live
// region. If the clipboard can't be written, the prompt shows, selected, to
// copy by hand.
import { SETUP_PROMPT } from "../agents/prompt.ts";

interface Props {
	class?: string;
}

const { class: className } = Astro.props;
---

<div class:list={["tk-prompt not-content", className]} data-tk-prompt>
	<span class="tk-prompt-label" aria-hidden="true">Or set it up with an agent</span>
	<button
		type="button"
		class="tk-prompt-button"
		data-prompt={SETUP_PROMPT}
		aria-label="Copy a prompt to set up Tack with your coding agent"
	>
		<span class="tk-prompt-term" aria-hidden="true">
			<svg viewBox="0 0 20 20" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
				<path d="m4.5 6 4 4-4 4" />
				<path class="tk-prompt-caret" d="M10.5 14.5h5" />
			</svg>
		</span>
		<span class="tk-prompt-swap" aria-hidden="true">
			<span class="tk-prompt-idle">Copy prompt</span>
			<span class="tk-prompt-done">
				<svg viewBox="0 0 20 20" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
					<path class="tk-prompt-tick" d="m4.5 10.5 3.6 3.6 7.4-8.2" pathLength="1" />
				</svg>
				Copied
			</span>
		</span>
	</button>
	<span class="tk-prompt-status sr-only" role="status"></span>
	<textarea class="tk-prompt-manual" readonly hidden rows="4" aria-label="The prompt, to copy by hand">{SETUP_PROMPT}</textarea>
</div>

<script>
	// Copies the prompt; "Copied" for a few seconds, then back. If the
	// clipboard can't be written (an insecure page, a denied permission), the
	// prompt shows, selected, for copying by hand.
	const COPIED_FOR = 3000;
	for (const root of document.querySelectorAll<HTMLElement>("[data-tk-prompt]")) {
		const button = root.querySelector<HTMLButtonElement>(".tk-prompt-button");
		const status = root.querySelector<HTMLElement>(".tk-prompt-status");
		const manual = root.querySelector<HTMLTextAreaElement>(".tk-prompt-manual");
		if (!button || !status || !manual) continue;
		let timer: ReturnType<typeof setTimeout> | undefined;
		button.addEventListener("click", async () => {
			clearTimeout(timer);
			const prompt = button.dataset.prompt ?? "";
			try {
				if (!navigator.clipboard?.writeText) throw new Error("No clipboard");
				await navigator.clipboard.writeText(prompt);
			} catch {
				root.dataset.state = "manual";
				status.textContent = "Couldn’t copy the prompt. It’s selected below: copy it from there.";
				manual.hidden = false;
				manual.focus();
				manual.select();
				return;
			}
			manual.hidden = true;
			// Restart the tick's animation if it's copied again while showing.
			delete root.dataset.state;
			void root.offsetWidth;
			root.dataset.state = "copied";
			status.textContent = "Prompt copied. Paste it into your coding agent.";
			timer = setTimeout(() => {
				delete root.dataset.state;
				status.textContent = "";
			}, COPIED_FOR);
		});
	}
</script>

<style>
	.tk-prompt {
		display: grid;
		justify-items: start;
		gap: 0.45rem;
		max-width: 100%;
	}

	.tk-prompt-label {
		color: var(--tk-muted);
		font-size: var(--sl-text-sm);
	}

	/* Dark in both themes, like a terminal: lifts a little when pointed at. */
	.tk-prompt-button {
		display: inline-flex;
		align-items: center;
		gap: 0.6rem;
		margin: 0;
		padding: 0.6rem 1.1rem 0.6rem 0.75rem;
		border: 1px solid rgb(255 255 255 / 8%);
		border-radius: 12px;
		background: #1c1d21;
		box-shadow: var(--tk-shadow-rest);
		color: #f3f3f1;
		font: inherit;
		font-size: var(--sl-text-base);
		font-weight: 600;
		cursor: pointer;
		-webkit-tap-highlight-color: transparent;
		transition:
			transform var(--tk-t-base) var(--tk-ease-spring),
			box-shadow var(--tk-t-base) var(--tk-ease-out),
			background-color var(--tk-t-quick) var(--tk-ease-out);
	}

	.tk-prompt-button:hover {
		transform: translateY(-1px);
		background: #26282d;
		box-shadow: var(--tk-shadow-lifted);
	}

	/* On a dark page, a shade lighter than it, so it still reads as a button. */
	:global([data-theme="dark"]) .tk-prompt-button {
		border-color: rgb(255 255 255 / 14%);
		background: #2a2c32;
	}

	:global([data-theme="dark"]) .tk-prompt-button:hover {
		background: #33363c;
	}

	.tk-prompt-button:active {
		transform: scale(0.97);
		transition-duration: var(--tk-t-quick);
	}

	.tk-prompt-button:focus-visible {
		outline: 2px solid var(--tk-accent);
		outline-offset: 3px;
	}

	/* The terminal: a prompt and a caret, which blinks while it's pointed at. */
	.tk-prompt-term {
		display: grid;
		place-items: center;
		width: 1.75rem;
		height: 1.75rem;
		border-radius: 7px;
		background: rgb(255 255 255 / 10%);
		color: #9ff0b4;
	}

	.tk-prompt-button:hover .tk-prompt-caret,
	.tk-prompt-button:focus-visible .tk-prompt-caret {
		animation: tk-prompt-blink 1.05s steps(1) infinite;
	}

	@keyframes tk-prompt-blink {
		50% {
			opacity: 0;
		}
	}

	/* Both words laid out in one place, so swapping them moves nothing. */
	.tk-prompt-swap {
		display: inline-grid;
	}

	.tk-prompt-swap > * {
		grid-area: 1 / 1;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: 0.35rem;
		transition:
			opacity var(--tk-t-base) var(--tk-ease-out),
			transform var(--tk-t-settle) var(--tk-ease-spring),
			filter var(--tk-t-base) var(--tk-ease-out);
	}

	.tk-prompt-done {
		color: #9ff0b4;
		opacity: 0;
		transform: translateY(0.45em);
		filter: blur(2px);
		visibility: hidden;
	}

	[data-state="copied"] .tk-prompt-idle {
		opacity: 0;
		transform: translateY(-0.45em);
		filter: blur(2px);
	}

	[data-state="copied"] .tk-prompt-done {
		opacity: 1;
		transform: none;
		filter: none;
		visibility: visible;
	}

	.tk-prompt-tick {
		stroke-dasharray: 1;
		stroke-dashoffset: 1;
	}

	[data-state="copied"] .tk-prompt-tick {
		animation: tk-prompt-tick var(--tk-t-settle) var(--tk-ease-out) 80ms forwards;
	}

	@keyframes tk-prompt-tick {
		to {
			stroke-dashoffset: 0;
		}
	}

	/* The prompt itself, when it couldn't be copied. */
	.tk-prompt-manual {
		width: min(100%, 28rem);
		padding: 0.6rem 0.75rem;
		border: 1px solid var(--tk-line-strong);
		border-radius: 10px;
		background: var(--tk-surface-muted);
		color: var(--tk-ink);
		font-family: var(--tk-font-mono);
		font-size: var(--sl-text-xs);
		line-height: 1.5;
		resize: none;
		field-sizing: content;
	}

	.tk-prompt-manual[hidden] {
		display: none;
	}

	@media (prefers-reduced-motion: reduce) {
		.tk-prompt-button:hover,
		.tk-prompt-button:active {
			transform: none;
		}

		.tk-prompt-button .tk-prompt-caret {
			animation: none !important;
		}

		.tk-prompt-tick {
			stroke-dashoffset: 0;
		}
	}
</style>
