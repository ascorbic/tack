---
// A screenshot of a /play scenario (scripts/screenshots.ts), in whichever
// theme the reader has chosen.
import { Image } from "astro:assets";

interface Props {
	/** The screenshot's name, e.g. "planning" for planning-light.webp and planning-dark.webp. */
	name: string;
	alt: string;
	caption?: string;
	/** Load it straight away: for the first screen of a page. */
	eager?: boolean;
	/** A phone's screen: shown narrow, with a phone's rounded corners. */
	phone?: boolean;
	class?: string;
}

const shots = import.meta.glob<{ default: ImageMetadata }>("../assets/screenshots/*.webp", {
	eager: true,
});
const { name, alt, caption, eager = false, phone = false, class: className } = Astro.props;
const light = shots[`../assets/screenshots/${name}-light.webp`]?.default;
const dark = shots[`../assets/screenshots/${name}-dark.webp`]?.default;
if (!light || !dark) {
	throw new Error(`No screenshot called “${name}”: run \`pnpm --filter site screenshots\``);
}
const widths = phone ? [360, 720, 1080] : [720, 1100, 1440, 2200];
const sizes = phone ? "20rem" : "(min-width: 72rem) 45rem, 100vw";
const loading = eager ? "eager" : "lazy";
---

<figure class:list={["tk-shot-figure", className]} data-phone={phone || undefined}>
	<span class="tk-shot">
		<Image
			src={light}
			{alt}
			{widths}
			{sizes}
			{loading}
			class="dark:sl-hidden"
			format="webp"
		/>
		<Image
			src={dark}
			{alt}
			{widths}
			{sizes}
			{loading}
			class="light:sl-hidden"
			format="webp"
		/>
	</span>
	{caption && <figcaption class="tk-caption">{caption}</figcaption>}
</figure>

<style>
	.tk-shot-figure {
		margin: 1.75rem 0;
	}

	.tk-shot-figure[data-phone] :global(.tk-shot) {
		max-width: 20rem;
		margin-inline: auto;
		border-radius: 28px;
		border-width: 6px;
		border-color: #1b1b20;
	}

	.tk-shot-figure figcaption {
		margin-top: 0.6rem;
	}
</style>
