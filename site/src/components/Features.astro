---
// The landing page's reasons, each beside the board that shows it.
import Screenshot from "./Screenshot.astro";

const FEATURES = [
	{
		kicker: "Write back",
		title: "Decide on the board, then push it to GitHub",
		body: "Stickies become issues, a section a parent issue with sub-issues, an arrow a blocked-by link, a decision an ADR pull request; labels, milestones and assignees too. It all waits in one list until someone reviews it and pushes, as themselves or as the app's bot.",
		link: { href: "/writing-back/overview/", text: "How writing back works" },
		shot: "push",
		alt: "The push sheet: new issues with their bodies and labels, a pull request, how many watchers will be notified, and a choice of pushing as yourself or as Tack's bot.",
		sticky: "yellow",
	},
	{
		kicker: "Stacks and AI",
		title: "From a wall of stickies to a few themes",
		body: "Drag one sticky onto another and they become a stack, like apps in a folder on your phone. Issues and pull requests stack too. Tack suggests a name for each stack from what's in it, or sorts a whole wall of stickies into themes in one go. The AI runs on your own Cloudflare account, and every suggestion is yours to keep, rename or undo.",
		link: { href: "/boards/stacks/", text: "Stacks" },
		shot: "stacks",
		alt: "A planning board: stickies about what to fix in unpic 5.0, and three stacks beside them, each a card with its name, how many it holds and its first few stickies and issues.",
		sticky: "purple",
	},
	{
		kicker: "Facilitation",
		title: "Live, or across time zones",
		body: "Start from a template for a planning session, a retro or triage, with each step ready to run. On a call, there's a shared timer, spotlight, silent writing and stamps. Off it, dot votes stay open for days, comments thread, “since you were here” catches people up, and a weekly digest goes out as a GitHub Discussion or by email.",
		link: { href: "/facilitation/running-a-session/", text: "Running a session" },
		shot: "retro",
		alt: "A retro board with sections for what went well, what to improve and ideas, with stickies, stamps and cards.",
		sticky: "green",
	},
	{
		kicker: "Widgets and automation",
		title: "Boards that keep themselves current",
		body: "Live lists, a timeline, a release draft, a dependency map with its critical path, a review queue, milestone progress and a stale finder, or a widget of your own, sandboxed. Inbox sections collect new matches for a search, and rules place pull requests beside the issues they fix.",
		link: { href: "/widgets/overview/", text: "The widgets" },
		shot: "roadmap",
		alt: "A timeline of issues opened over a month, a release draft sorted into features, fixes and docs, and a dependency map flagging a cycle and the critical path.",
		sticky: "blue",
	},
	{
		kicker: "Phones and tablets",
		title: "Join in from your phone",
		body: "Tap anything on a board to read it, vote, stamp and comment, and add stickies from the +. On a tablet, edit with a finger or a pencil.",
		link: { href: "/boards/phones-and-tablets/", text: "Phones and tablets" },
		shot: "phone",
		phone: true,
		alt: "A phone showing a sticky from a dot vote in a sheet: its words big enough to read, two of your dots on it, one left, and stamps to add.",
		sticky: "pink",
	},
];
---

<div class="tk-features">
	<header class="tk-features-intro">
		<h2>For teams who plan in the open</h2>
		<p>
			Maintainers and contributors planning releases, roadmaps, triage and retros, together on a
			call or across time zones over a week. The board is where you think; GitHub is where it lands.
		</p>
	</header>
	{
		FEATURES.map((feature, index) => (
			<section class="tk-feature" data-flip={index % 2 === 1 ? "" : undefined}>
				<div class="tk-feature-copy">
					<p class="tk-feature-kicker" data-sticky={feature.sticky}>
						{feature.kicker}
					</p>
					<h2>{feature.title}</h2>
					<p>{feature.body}</p>
					<a class="tk-feature-link" href={feature.link.href}>
						{feature.link.text}
						<span aria-hidden="true">→</span>
					</a>
				</div>
				<Screenshot
					name={feature.shot}
					alt={feature.alt}
					phone={feature.phone}
					class="tk-feature-shot"
				/>
			</section>
		))
	}
</div>

<style>
	.tk-features {
		display: grid;
		gap: clamp(3rem, 8vw, 6rem);
		margin-block: clamp(4rem, 10vw, 7rem) 2rem;
	}

	.tk-features-intro {
		max-width: 40rem;
	}

	.tk-features-intro h2 {
		margin: 0 0 0.75rem;
		font-size: clamp(1.8rem, 1.3rem + 2vw, 2.7rem);
		line-height: 1.05;
		letter-spacing: -0.03em;
		color: var(--sl-color-white);
		text-wrap: balance;
	}

	.tk-features-intro p {
		margin: 0;
		color: var(--tk-ink-soft);
		font-size: clamp(1.05rem, 0.95rem + 0.6vw, 1.3rem);
		line-height: 1.55;
		text-wrap: pretty;
	}

	.tk-feature {
		display: grid;
		gap: 1.5rem;
		align-items: center;
	}

	@media (min-width: 56rem) {
		.tk-feature {
			grid-template-columns: 5fr 7fr;
			gap: 3.5rem;
		}

		.tk-feature[data-flip] {
			grid-template-columns: 7fr 5fr;
		}

		.tk-feature[data-flip] .tk-feature-copy {
			order: 2;
		}
	}

	.tk-feature-copy {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: 0.75rem;
	}

	.tk-feature-copy > * {
		margin: 0;
	}

	.tk-feature-kicker {
		padding: 0.25rem 0.6rem;
		border-radius: 3px 3px 3px 9px;
		background: var(--tk-sticky-yellow);
		box-shadow: var(--tk-sticky-shadow);
		color: var(--tk-sticky-ink);
		font-size: var(--sl-text-xs);
		font-weight: 650;
		transform: rotate(-2deg);
	}

	.tk-feature-kicker[data-sticky="blue"] {
		background: var(--tk-sticky-blue);
		transform: rotate(1.5deg);
	}

	.tk-feature-kicker[data-sticky="green"] {
		background: var(--tk-sticky-green);
	}

	.tk-feature-kicker[data-sticky="purple"] {
		background: var(--tk-sticky-purple);
		transform: rotate(-1deg);
	}

	.tk-feature-kicker[data-sticky="pink"] {
		background: var(--tk-sticky-pink);
		transform: rotate(2deg);
	}

	.tk-feature h2 {
		font-size: clamp(1.6rem, 1.2rem + 1.5vw, 2.3rem);
		line-height: 1.1;
		color: var(--sl-color-white);
		text-wrap: balance;
	}

	.tk-feature-copy p:not(.tk-feature-kicker) {
		color: var(--tk-ink-soft);
		font-size: var(--sl-text-lg);
		line-height: 1.6;
	}

	.tk-feature-link {
		font-weight: 600;
		text-decoration: none;
		color: var(--sl-color-text-accent);
	}

	.tk-feature-link span {
		display: inline-block;
		transition: transform var(--tk-t-base) var(--tk-ease-spring);
	}

	.tk-feature-link:hover span {
		transform: translateX(4px);
	}

	.tk-feature :global(.tk-feature-shot) {
		margin: 0;
	}
</style>
