---
// The header's title: the mark and wordmark as on the app's top bar.
import BrandMark from "./BrandMark.astro";

const { siteTitleHref } = Astro.locals.starlightRoute;
---

<a href={siteTitleHref} class="site-title tk-brand">
	<BrandMark size={26} />
	<span class="tk-wordmark" translate="no">tack</span>
</a>

<style>
	.site-title {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		text-decoration: none;
		color: var(--sl-color-white);
		min-width: 0;
	}

	.tk-wordmark {
		font-family: var(--tk-font-display);
		font-size: 1.4rem;
		font-weight: 750;
		letter-spacing: -0.03em;
		line-height: 1;
	}

</style>
