---
// The landing page's close: who runs Tack, who sees what, and the two ways in again.
import { LinkButton } from "@astrojs/starlight/components";

const POINTS = [
	{
		title: "One Worker, on your account",
		body: "Each instance is a Cloudflare Worker and a GitHub App you own, set up in about fifteen minutes. There's no hosted Tack and no account to make with us.",
		link: { href: "/self-hosting/deploy/", text: "Get your own" },
	},
	{
		title: "GitHub decides who sees what",
		body: "Everyone signs in with GitHub. A card from a private repository only shows its details to people who can read it there, and pushes go out with each person's own permissions.",
		link: { href: "/start/introduction/#who-sees-what", text: "Who sees what" },
	},
	{
		title: "Not only GitHub",
		body: "Issues and merge requests from GitLab, Codeberg, other Forgejo instances and Tangled sit beside GitHub's, live where the instance gets their webhooks.",
		link: { href: "/self-hosting/forges/", text: "Other forges" },
	},
];
---

<section class="tk-own">
	<div class="tk-own-head">
		<h2>Open source, and yours to run</h2>
		<p>
			Tack is MIT licensed, and every instance is someone's own: the boards, and everything on them,
			stay in your Cloudflare account. Most of it runs on Workers' free plan.
		</p>
	</div>
	<ul class="tk-own-points">
		{
			POINTS.map((point) => (
				<li>
					<h3>{point.title}</h3>
					<p>{point.body}</p>
					<a href={point.link.href}>
						{point.link.text}
						<span aria-hidden="true">→</span>
					</a>
				</li>
			))
		}
	</ul>
	<div class="tk-own-actions">
		<LinkButton href="/try/" icon="right-arrow">Try it</LinkButton>
		<LinkButton href="/self-hosting/deploy/" variant="secondary">Get your own</LinkButton>
	</div>
</section>

<style>
	.tk-own {
		display: grid;
		gap: 2rem;
		margin-block: clamp(4rem, 10vw, 6rem) 3rem;
		padding: clamp(1.5rem, 4vw, 3rem);
		border-radius: 20px;
		border: 1px solid var(--tk-line-strong);
		background:
			radial-gradient(circle, var(--tk-ground-dots) 1px, transparent 1.4px) 0 0 / 22px 22px,
			var(--tk-ground);
	}

	.tk-own-head {
		max-width: 40rem;
	}

	.tk-own h2 {
		margin: 0 0 0.75rem;
		font-size: clamp(1.8rem, 1.3rem + 2vw, 2.7rem);
		line-height: 1.05;
		letter-spacing: -0.03em;
		color: var(--sl-color-white);
		text-wrap: balance;
	}

	.tk-own-head p {
		margin: 0;
		color: var(--tk-ink-soft);
		font-size: clamp(1.05rem, 0.95rem + 0.6vw, 1.3rem);
		line-height: 1.55;
		text-wrap: pretty;
	}

	.tk-own-points {
		display: grid;
		gap: 1rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	@media (min-width: 50rem) {
		.tk-own-points {
			grid-template-columns: repeat(3, minmax(0, 1fr));
		}
	}

	.tk-own-points li {
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
		margin: 0;
		padding: 1.25rem;
		border-radius: 14px;
		border: 1px solid var(--tk-line);
		background: var(--tk-surface);
		box-shadow: var(--tk-shadow-rest);
		transition:
			transform var(--tk-t-base) var(--tk-ease-spring),
			box-shadow var(--tk-t-base) var(--tk-ease-out);
	}

	.tk-own-points li:hover {
		transform: translateY(-2px);
		box-shadow: var(--tk-shadow-lifted);
	}

	.tk-own-points h3 {
		margin: 0;
		font-size: var(--sl-text-lg);
		line-height: 1.25;
		color: var(--sl-color-white);
	}

	.tk-own-points p {
		margin: 0;
		flex: 1;
		color: var(--tk-ink-soft);
		line-height: 1.55;
	}

	.tk-own-points a {
		font-weight: 600;
		text-decoration: none;
		color: var(--sl-color-text-accent);
	}

	.tk-own-points a span {
		display: inline-block;
		transition: transform var(--tk-t-base) var(--tk-ease-spring);
	}

	.tk-own-points a:hover span {
		transform: translateX(4px);
	}

	.tk-own-actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem 1.25rem;
		align-items: center;
	}

	.tk-own-actions :global(a) {
		margin: 0;
	}

	@media (prefers-reduced-motion: reduce) {
		.tk-own-points li,
		.tk-own-points a span {
			transition: none;
		}
	}
</style>
