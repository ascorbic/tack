---
// The Tack mark, as in the app (src/client/BrandMark.tsx): a sticky note,
// pinned with a tack. Hovering anything with `.tk-brand` swings the note.
interface Props {
	size?: number;
}
const { size = 24 } = Astro.props;
---

<svg class="tk-mark" width={size} height={size} viewBox="0 0 24 24" aria-hidden="true">
	<g class="tk-mark-note">
		<path d="M4.5 6.5h15v12.2l-3.3 3.3H4.5z" fill="#ffd85c"></path>
		<path d="M16.2 22v-3.3h3.3z" fill="#e8b93a"></path>
	</g>
	<g class="tk-mark-pin">
		<ellipse cx="12.6" cy="9.4" rx="3.1" ry="1.3" fill="rgb(0 0 0 / 18%)"></ellipse>
		<circle cx="12" cy="7" r="3.4" fill="#e5533d"></circle>
		<circle cx="10.9" cy="5.9" r="1.1" fill="rgb(255 255 255 / 55%)"></circle>
	</g>
</svg>

<style is:global>
	.tk-mark {
		overflow: visible;
		flex: none;
	}

	.tk-mark-note {
		transform-box: view-box;
		transform-origin: 12px 7px;
		transform: rotate(-5deg);
		transition: transform var(--tk-t-settle) var(--tk-ease-spring);
	}

	.tk-mark-pin {
		transition: transform var(--tk-t-settle) var(--tk-ease-spring);
	}

	.tk-brand:hover .tk-mark-note {
		transform: rotate(7deg);
	}

	.tk-brand:hover .tk-mark-pin {
		transform: translateY(-1.5px);
	}
</style>
