{
	"name": "site",
	"version": "0.0.0",
	"private": true,
	"description": "The Tack documentation site",
	"license": "MIT",
	"type": "module",
	"scripts": {
		"dev": "astro dev",
		"build": "astro build && node scripts/agents.ts && node scripts/try.ts && node scripts/build-output.ts",
		"preview": "astro preview",
		"deploy": "pnpm run build && cf deploy --prebuilt && node scripts/reindex.ts --after-deploy",
		"reindex": "node scripts/reindex.ts",
		"screenshots": "node scripts/screenshots.ts",
		"og": "node scripts/og.ts"
	},
	"dependencies": {
		"@astrojs/markdown-remark": "7.3.2",
		"@astrojs/sitemap": "3.7.4",
		"@astrojs/starlight": "0.42.6",
		"@fontsource-variable/bricolage-grotesque": "5.3.0",
		"@fontsource-variable/geist": "5.3.0",
		"@fontsource-variable/geist-mono": "5.3.0",
		"astro": "7.3.8",
		"sharp": "0.35.5",
		"starlight-links-validator": "0.27.0"
	},
	"devDependencies": {
		"@cloudflare/build-output-utils": "0.9.0",
		"@cloudflare/config": "0.24.1",
		"@playwright/test": "1.64.0",
		"@types/hast": "3.0.5",
		"@types/mdast": "4.0.4",
		"cf": "1.0.0-beta.14",
		"hast-util-from-html": "2.0.3",
		"hast-util-select": "6.0.4",
		"hast-util-to-mdast": "10.1.2",
		"mdast-util-gfm": "3.1.0",
		"mdast-util-to-markdown": "2.2.0"
	}
}
