{
	"name": "tack",
	"version": "0.0.0",
	"private": true,
	"description": "A GitHub-native whiteboard for open source planning",
	"keywords": [],
	"license": "MIT",
	"author": "Matt Kane",
	"type": "module",
	"scripts": {
		"postinstall": "cf workers types",
		"dev": "vp dev",
		"build": "vp build",
		"deploy": "vp build && cf deploy --prebuilt",
		"deploy:preview": "CLOUDFLARE_PREVIEW_BUILD=true vp build && cf previews deploy --prebuilt",
		"types": "cf workers types",
		"wrangler-config": "node scripts/wrangler-config.ts",
		"test": "vp test",
		"e2e": "playwright test -c e2e/playwright.config.ts",
		"e2e:webkit": "E2E_WEBKIT=1 playwright test -c e2e/playwright.config.ts --project=webkit",
		"e2e:update": "VISUAL=1 playwright test -c e2e/playwright.config.ts --update-snapshots",
		"check": "vp check",
		"fix": "vp check --fix",
		"e2e:visual": "VISUAL=1 playwright test -c e2e/playwright.config.ts"
	},
	"dependencies": {
		"@fontsource-variable/bricolage-grotesque": "^5.3.0",
		"@fontsource-variable/geist": "^5.3.0",
		"@fontsource-variable/geist-mono": "^5.3.0",
		"@fontsource-variable/shantell-sans": "^5.3.0",
		"@resvg/resvg-wasm": "2.6.2",
		"@xyflow/react": "^12.12.0",
		"acorn": "8.19.0",
		"fractional-indexing": "^4.0.0",
		"modern-screenshot": "4.7.0",
		"partyserver": "^0.5.10",
		"react": "^19.3.0",
		"react-dom": "^19.3.0",
		"satori": "0.32.0",
		"uqr": "0.1.3",
		"valibot": "^1.5.0",
		"y-partyserver": "^2.2.0",
		"y-protocols": "^1.0.7",
		"yjs": "^13.6.33"
	},
	"devDependencies": {
		"@axe-core/playwright": "^4.13.0",
		"@cloudflare/vite-plugin": "2.0.0-beta.sha-91c870c02",
		"@playwright/test": "^1.64.0",
		"@types/node": "^26.6.4",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@vitejs/plugin-react": "^6.1.2",
		"cf": "1.0.0-beta.14",
		"lib0": "^0.2.119",
		"miniflare": "5.20261006.1-alpha",
		"typescript": "^7.0.2",
		"vite-plus": "^1.1.0"
	},
	"engines": {
		"node": ">=22"
	},
	"packageManager": "pnpm@10.33.4",
	"cloudflare": {
		"label": "Tack",
		"products": [
			"Workers",
			"Durable Objects"
		],
		"bindings": {
			"TACK_SECRET": {
				"description": "Signs sessions and encrypts the GitHub App's credentials. Generate one with `openssl rand -base64 32`, keep a copy somewhere safe, and **never change it**."
			}
		}
	}
}
